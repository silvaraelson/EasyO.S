{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    // Campos de classe decorados (WatermelonDB) não podem usar `!:` nem
    // `declare` com o babel-preset-expo atual (quebra o build release —
    // ver src/db/models/ServiceOrder.ts), então ficam sem inicializador.
    "strictPropertyInitialization": false
  }
}
